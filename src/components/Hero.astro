---
import { Picture } from "astro:assets";
import profile from "../assets/images/kavi.jpeg";
---

<section
    class="relative flex flex-col items-center justify-center min-h-[90vh] text-center px-6 overflow-hidden"
    id="hero"
>
    <!-- Abstract background elements -->
    <div
        class="absolute top-1/4 -left-20 w-64 h-64 bg-primary/10 rounded-full blur-3xl -z-10"
    >
    </div>
    <div
        class="absolute bottom-1/4 -right-20 w-96 h-96 bg-primary/5 rounded-full blur-3xl -z-10"
    >
    </div>

    <div class="motion-enter">
        <div
            class="relative inline-block animate-float motion-standard motion-hover-lift top-16"
        >
            <div
                class="absolute inset-0 bg-gradient-to-tr from-neon-blue to-neon-purple blur-2xl opacity-20 group-hover:opacity-40 motion-standard"
            >
            </div>
            <Picture
                src={profile}
                formats={["avif", "webp"]}
                alt="Kavi Castelo"
                class="relative w-32 h-32 md:w-40 md:h-40 rounded-3xl border-2 border-primary/50 shadow-2xl rotate-3 hover:rotate-0 motion-standard object-cover p-1 bg-surface"
                loading="eager"
            />
            <div
                class="absolute -bottom-3 -right-3 w-10 h-10 bg-primary rounded-xl flex items-center justify-center text-on-primary text-lg font-bold shadow-[0_0_20px_rgba(var(--primary-rgb),0.5)] border border-white/20 neon-pulse"
            >
                🚀
            </div>
        </div>

        <h1
            class="text-5xl md:text-8xl font-black mt-10 tracking-tighter leading-none motion-standard"
        >
            Kavi <span
                class="text-transparent bg-clip-text bg-gradient-to-r from-neon-blue via-primary to-neon-purple neon-text"
                >Castelo</span
            >
        </h1>

        <h2
            class="text-xl md:text-3xl text-on-surface/70 mt-6 font-semibold max-w-3xl mx-auto leading-tight italic motion-standard"
        >
            Engineering the Future | <span class="text-on-surface"
                >Leading with Code & Innovation</span
            >
        </h2>

        <p
            class="mt-8 text-on-surface/60 max-w-xl mx-auto text-lg font-medium motion-standard"
        >
            Architecting scalable AI-driven solutions and high-performance
            enterprise ecosystems with precision.
        </p>

        <div
            class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-6"
        >
            <a
                href="#projects"
                class="w-full sm:w-auto px-10 py-5 bg-primary text-on-primary font-black rounded-2xl shadow-xl shadow-primary/30 hover:shadow-primary/50 hover:bg-primary-hover motion-standard motion-hover-lift motion-press neon-border group relative overflow-hidden"
            >
                <span class="relative z-10">Explore My Work</span>
                <div
                    class="absolute inset-0 bg-white/10 translate-y-full group-hover:translate-y-0 motion-standard"
                >
                </div>
            </a>
            <a
                href="#contact"
                class="w-full sm:w-auto px-10 py-5 bg-surface-muted text-on-surface font-bold rounded-2xl border border-border hover:bg-border motion-standard motion-hover-lift motion-press glass"
            >
                Get in Touch
            </a>
        </div>
    </div>
</section>

<script>
    import { revealInit } from "../scripts/reveal.js";
    revealInit();
</script>
