---
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
    { name: "About", href: "/#about" },
    { name: "Projects", href: "/#projects" },
    { name: "Blog", href: "/#blog" },
    { name: "FAQs", href: "/#faq" },
    { name: "Contact", href: "/#contact" },
];
---

<header
    class="fixed top-0 left-0 right-0 z-50 motion-standard glass border-transparent border-b"
>
    <nav class="flex justify-between items-center px-6 py-4 max-w-7xl mx-auto">
        <a
            href="/"
            class="text-on-surface font-bold text-2xl tracking-tight hover:text-primary motion-standard neon-text"
        >
            Kavi Castelo
        </a>

        <div class="flex items-center gap-6">
            <ul
                class="hidden md:flex space-x-8 text-on-surface/80 font-medium h-full items-center"
            >
                {
                    navItems.map((item) => (
                        <li class="h-full">
                            <a
                                href={item.href}
                                class="hover:text-primary motion-standard relative group flex items-center h-full"
                            >
                                {item.name}
                                <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-primary motion-standard group-hover:w-full" />
                            </a>
                        </li>
                    ))
                }
            </ul>

            <div class="h-6 w-px bg-border hidden md:block"></div>

            <ThemeToggle />

            <!-- Mobile Menu Toggle Placeholder -->
            <button
                class="md:hidden p-2 text-on-surface motion-standard motion-press"
                aria-label="Menu"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="motion-standard"
                    ><line x1="3" y1="12" x2="21" y2="12"></line><line
                        x1="3"
                        y1="6"
                        x2="21"
                        y2="6"></line><line x1="3" y1="18" x2="21" y2="18"
                    ></line></svg
                >
            </button>
        </div>
    </nav>
</header>

<script>
    // Handle header shadow/border on scroll
    function updateHeader() {
        const header = document.querySelector("header");
        if (window.scrollY > 20) {
            header?.classList.add("shadow-sm", "border-border");
            header?.classList.remove("border-transparent");
        } else {
            header?.classList.remove("shadow-sm", "border-border");
            header?.classList.add("border-transparent");
        }
    }

    window.addEventListener("scroll", updateHeader);
    document.addEventListener("astro:after-swap", updateHeader);
    updateHeader();
</script>
