---
import { getCollection } from "astro:content";

interface Props {
    limit?: number;
}

const { limit = 3 } = Astro.props;

const posts = (await getCollection("blog", ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, limit);
---

<section class="py-24 px-6 max-w-7xl mx-auto" id="blog">
    <div
        class="motion-enter mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6"
    >
        <div class="space-y-4">
            <h2
                class="text-3xl md:text-4xl font-bold tracking-tight motion-standard"
            >
                Latest <span class="text-primary neon-text">Insights</span>
            </h2>
            <p class="text-on-surface/60 max-w-xl text-lg motion-standard">
                Thoughts on software engineering, leadership, and the future of
                technology.
            </p>
        </div>
        {
            limit !== Infinity && (
                <a
                    href="/blog"
                    class="hidden md:flex items-center gap-2 font-bold text-primary hover:text-primary-hover motion-standard motion-hover-lift motion-press"
                >
                    All Articles
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="motion-standard"
                    >
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                    </svg>
                </a>
            )
        }
    </div>

    <div class="space-y-6">
        {
            posts.map((post, index) => (
                <div
                    class="motion-enter group relative bg-surface-muted rounded-2xl border border-border p-6 md:p-8 motion-standard hover:border-primary hover:shadow-xl"
                    style={`transition-delay: ${index * 100}ms`}
                >
                    <div class="flex flex-col md:flex-row gap-6 md:items-center justify-between">
                        <div class="space-y-2 flex-grow">
                            <div class="flex items-center gap-3 text-sm font-medium text-on-surface/40 motion-standard">
                                <span class="bg-primary/10 text-primary px-2 py-0.5 rounded text-xs uppercase tracking-wider motion-standard">
                                    {post.data.tags[0] || "Engineering"}
                                </span>
                                <span>•</span>
                                <time
                                    datetime={post.data.date.toISOString()}
                                    class="motion-standard"
                                >
                                    {post.data.date.toLocaleDateString(
                                        "en-US",
                                        {
                                            year: "numeric",
                                            month: "long",
                                            day: "numeric",
                                        },
                                    )}
                                </time>
                            </div>
                            <h3 class="text-xl md:text-2xl font-bold group-hover:text-primary motion-standard">
                                {post.data.title}
                            </h3>
                            <p class="text-on-surface/70 line-clamp-2 max-w-3xl motion-standard">
                                {post.data.description}
                            </p>
                        </div>
                        <div class="shrink-0 flex items-center md:justify-end">
                            <a
                                href={`/blog/${post.slug}`}
                                class="inline-flex items-center gap-2 font-bold text-primary hover:text-primary-hover motion-standard motion-hover-lift motion-press rounded-lg group-hover:bg-primary group-hover:text-on-primary md:px-6 md:py-3"
                            >
                                Read Article
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="18"
                                    height="18"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="motion-standard"
                                >
                                    <>
                                        <line x1="5" y1="12" x2="19" y2="12" />
                                        <polyline points="12 5 19 12 12 19" />
                                    </>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            ))
        }
    </div>

    {
        limit !== Infinity && (
            <div class="motion-enter mt-12 text-center md:hidden">
                <a
                    href="/blog"
                    class="inline-flex items-center gap-2 font-bold text-primary hover:text-primary-hover motion-standard motion-hover-lift motion-press"
                >
                    View All Articles
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="motion-standard"
                    >
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                    </svg>
                </a>
            </div>
        )
    }
</section>
