---

---

<footer
    class="py-12 px-6 border-t border-border bg-surface-muted/50 motion-standard"
>
    <div
        class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6"
    >
        <div class="space-y-2 text-center md:text-left">
            <p class="font-bold text-xl tracking-tight">Kavi Castelo</p>
            <p class="text-sm text-on-surface/40">
                &copy; {new Date().getFullYear()} All Rights Reserved.
            </p>
        </div>

        <nav>
            <ul
                class="flex flex-wrap justify-center gap-6 text-sm font-medium text-on-surface/60"
            >
                <li>
                    <a
                        href="#about"
                        class="hover:text-primary transition-colors">About</a
                    >
                </li>
                <li>
                    <a
                        href="#projects"
                        class="hover:text-primary transition-colors">Projects</a
                    >
                </li>
                <li>
                    <a href="#blog" class="hover:text-primary transition-colors"
                        >Blog</a
                    >
                </li>
                <li>
                    <a href="#faq" class="hover:text-primary transition-colors"
                        >FAQs</a
                    >
                </li>
                <li>
                    <a
                        href="#contact"
                        class="hover:text-primary transition-colors">Contact</a
                    >
                </li>
            </ul>
        </nav>

        <div
            class="text-on-surface/40 hover:text-primary transition-colors cursor-help group relative neon-pulse"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="10"></circle><line
                    x1="12"
                    y1="16"
                    x2="12"
                    y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"
                ></line></svg
            >
            <span
                class="absolute bottom-full mb-2 right-0 bg-on-surface text-surface text-[10px] px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap"
            >
                Built with Astro & Tailwind 4
            </span>
        </div>
    </div>
</footer>
