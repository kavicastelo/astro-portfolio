---
import projects from "../../data/projects.json";
import Layout from "../../layouts/Layout.astro";
import { Picture } from "astro:assets";

// Define the dynamic route
export function getStaticPaths() {
    // Return all project slugs so Astro can generate the pages for each one
    return projects.map((project) => ({
        params: { slug: project.slug },
    }));
}

const { slug } = Astro.params;
const project = projects.find((p) => p.slug === slug);

if (!project) throw new Error("Project not found");

const { title, image, details, tech, description, keywords } = project;
const hasGitHub = details.github && details.github.trim() !== "";
const hasNote = details.note && details.note.trim() !== "";
---

<Layout
    seo={{
        title: title,
        description: description,
    }}
    author="Kavi Castelo"
    keywords={keywords.join(", ")}
>
    <!-- Notification Element -->
    {
        hasNote && (
            <div class="fixed top-0 left-0 right-0 bg-primary text-on-primary text-sm text-center py-2 z-50 neon-border">
                {details.note}
            </div>
        )
    }

    <section class="py-24 px-6 min-h-screen">
        <div class="max-w-4xl mx-auto">
            <a
                href="/projects"
                class="inline-flex items-center gap-2 text-primary hover:text-primary-hover font-bold mb-8 transition-colors group"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="transition-transform group-hover:-translate-x-1"
                    ><line x1="19" y1="12" x2="5" y2="12"></line><polyline
                        points="12 19 5 12 12 5"></polyline></svg
                >
                Back to Projects
            </a>

            <div class="motion-enter">
                <div
                    class="relative group rounded-3xl overflow-hidden mb-12 border border-border neon-border"
                >
                    <Picture
                        src={image}
                        alt={title}
                        width="1200"
                        height="800"
                        formats={["avif", "webp"]}
                        loading="eager"
                        class="w-full aspect-video object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                    <div
                        class="absolute inset-0 bg-gradient-to-t from-surface to-transparent opacity-20 group-hover:opacity-10 transition-opacity"
                    >
                    </div>
                </div>

                <div
                    class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12"
                >
                    <div class="space-y-4">
                        <h1
                            class="text-4xl md:text-6xl font-extrabold tracking-tight neon-text"
                        >
                            {title}
                        </h1>
                        <p class="text-xl text-on-surface/60 font-medium">
                            {details.projectType} | {details.duration}
                        </p>
                    </div>
                    <div class="flex gap-4">
                        {
                            hasGitHub && (
                                <a
                                    href={details.github}
                                    class="px-6 py-3 bg-surface-muted border border-border rounded-xl font-bold hover:bg-border transition-all active:scale-95"
                                >
                                    GitHub
                                </a>
                            )
                        }
                        <a
                            href={details.live_demo}
                            class="px-6 py-3 bg-primary text-on-primary rounded-xl font-bold hover:bg-primary-hover shadow-lg shadow-primary/20 transition-all active:scale-95"
                            >Live Demo</a
                        >
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
                    <div
                        class="p-6 bg-surface-muted rounded-2xl border border-border"
                    >
                        <h2
                            class="text-sm font-bold text-on-surface/40 uppercase tracking-widest mb-4"
                        >
                            Languages
                        </h2>
                        <div class="flex flex-wrap gap-2">
                            {
                                tech.languages.map((l) => (
                                    <span class="px-3 py-1 bg-primary/10 text-primary rounded-lg text-xs font-bold border border-primary/20">
                                        {l}
                                    </span>
                                ))
                            }
                        </div>
                    </div>
                    <div
                        class="p-6 bg-surface-muted rounded-2xl border border-border"
                    >
                        <h2
                            class="text-sm font-bold text-on-surface/40 uppercase tracking-widest mb-4"
                        >
                            Frameworks
                        </h2>
                        <div class="flex flex-wrap gap-2">
                            {
                                tech.frameworks.map((f) => (
                                    <span class="px-3 py-1 bg-primary/10 text-primary rounded-lg text-xs font-bold border border-primary/20">
                                        {f}
                                    </span>
                                ))
                            }
                        </div>
                    </div>
                    <div
                        class="p-6 bg-surface-muted rounded-2xl border border-border"
                    >
                        <h2
                            class="text-sm font-bold text-on-surface/40 uppercase tracking-widest mb-4"
                        >
                            Tools
                        </h2>
                        <div class="flex flex-wrap gap-2">
                            {
                                tech.tools.map((t) => (
                                    <span class="px-3 py-1 bg-primary/10 text-primary rounded-lg text-xs font-bold border border-primary/20">
                                        {t}
                                    </span>
                                ))
                            }
                        </div>
                    </div>
                </div>

                <div
                    class="prose prose-lg dark:prose-invert max-w-none space-y-12"
                >
                    <section class="motion-enter">
                        <h2 class="text-3xl font-bold motion-standard">
                            Overview
                        </h2>
                        <p
                            class="text-on-surface/80 leading-relaxed motion-standard"
                        >
                            {details.overview}
                        </p>
                    </section>

                    <div class="grid md:grid-cols-2 gap-12">
                        <section class="motion-enter">
                            <h2
                                class="text-2xl font-bold text-primary motion-standard"
                            >
                                Problem Statement
                            </h2>
                            <p
                                class="text-on-surface/80 leading-relaxed mt-4 motion-standard"
                            >
                                {details.problem}
                            </p>
                        </section>
                        <section class="motion-enter">
                            <h2
                                class="text-2xl font-bold text-primary motion-standard"
                            >
                                The Task
                            </h2>
                            <p
                                class="text-on-surface/80 leading-relaxed mt-4 motion-standard"
                            >
                                {details.task}
                            </p>
                        </section>
                    </div>

                    <div class="grid md:grid-cols-2 gap-12">
                        <section class="motion-enter">
                            <h3 class="text-2xl font-bold motion-standard">
                                Solutions
                            </h3>
                            <ul class="space-y-3 mt-4 motion-standard">
                                {
                                    details.solutions.map((solution) => (
                                        <li class="flex items-start gap-3 text-on-surface/80 motion-standard">
                                            <svg
                                                class="w-6 h-6 text-primary shrink-0 motion-standard"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                                stroke-width="2"
                                            >
                                                <polyline points="20 6 9 17 4 12" />
                                            </svg>
                                            {solution}
                                        </li>
                                    ))
                                }
                            </ul>
                        </section>
                        <section class="motion-enter">
                            <h3 class="text-2xl font-bold motion-standard">
                                Key Features
                            </h3>
                            <ul class="space-y-3 mt-4 motion-standard">
                                {
                                    details.features.map((feature) => (
                                        <li class="flex items-start gap-3 text-on-surface/80 motion-standard">
                                            <svg
                                                class="w-6 h-6 text-primary shrink-0 motion-standard"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                                stroke-width="2"
                                            >
                                                <>
                                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                                    <polyline points="22 4 12 14.01 9 11.01" />
                                                </>
                                            </svg>
                                            {feature}
                                        </li>
                                    ))
                                }
                            </ul>
                        </section>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script
        type="application/ld+json"
        set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            name: title,
            image: image,
            description: description,
            author: {
                "@type": "Person",
                name: "Kavi Castelo",
                url: "https://kavicastelo-dev.netlify.app/",
            },
            publisher: {
                "@type": "Organization",
                name: "Talentboozt",
            },
            applicationCategory: "WebApplication",
            operatingSystem: "All",
            offers: {
                "@type": "Offer",
                price: "0",
                priceCurrency: "USD",
            },
            url: `https://kavicastelo-dev.netlify.app/projects/${slug}`,
        })}
    />
</Layout>
